<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hacker News Best Stories</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background-color: #f6f6ef; }
        .hn-header { background-color: #ff6600; }
        .hn-header a { color: #000; text-decoration: none; font-weight: bold; }
        .story-score { min-width: 50px; text-align: center; }
    </style>
</head>
<body>
    <nav class="navbar hn-header px-3 py-2 mb-4">
        <a class="navbar-brand" href="/">&#9650; Hacker News Best Stories</a>
        <a href="/swagger" class="btn btn-sm btn-dark ms-auto text-white">API Docs</a>
    </nav>
    <div class="container">
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
