@page
@model IndexModel
@{
    ViewData["Title"] = "Best Stories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Best Stories</h4>
    <div class="d-flex align-items-center gap-2">
        <label class="mb-0 text-muted small">Per page:</label>
        <form method="get" class="d-flex gap-1">
            <input type="hidden" name="currentPage" value="1" />
            <select name="pageSize" class="form-select form-select-sm" style="width:80px" onchange="this.form.submit()">
                @foreach (var size in new[] { 5, 10, 20, 50 })
                {
                    <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                }
            </select>
        </form>
    </div>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else if (!Model.Result.Items.Any())
{
    <div class="alert alert-info">No stories found.</div>
}
else
{
    <div class="list-group mb-4">
        @foreach (var (story, index) in Model.Result.Items.Select((s, i) => (s, i)))
        {
            var rank = (Model.Result.Page - 1) * Model.Result.PageSize + index + 1;
            <div class="list-group-item list-group-item-action">
                <div class="d-flex gap-3 align-items-start">
                    <span class="story-score badge bg-warning text-dark fs-6 mt-1">@story.Score</span>
                    <div class="flex-grow-1">
                        <div class="fw-semibold">
                            <span class="text-muted me-1">@rank.</span>
                            @if (story.Uri is not null)
                            {
                                <a href="@story.Uri" target="_blank" rel="noopener noreferrer">@story.Title</a>
                            }
                            else
                            {
                                @story.Title
                            }
                        </div>
                        <small class="text-muted">
                            by <strong>@story.PostedBy</strong>
                            &nbsp;|&nbsp; @story.CommentCount comments
                            &nbsp;|&nbsp; @story.Time
                        </small>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.Result.HasPrevious ? "disabled" : "")">
                <a class="page-link" href="?currentPage=@(Model.Result.Page - 1)&pageSize=@Model.PageSize">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.Result.Page of @Model.Result.TotalPages</span>
            </li>
            <li class="page-item @(!Model.Result.HasNext ? "disabled" : "")">
                <a class="page-link" href="?currentPage=@(Model.Result.Page + 1)&pageSize=@Model.PageSize">Next</a>
            </li>
        </ul>
    </nav>
}
